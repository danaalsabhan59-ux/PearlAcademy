{
 "voice": "ar-SA-HamedNeural",
 "baseRate": 0,
 "note": "start = when the matching on-screen text appears (+~0.1 s); end = latest finish while that text is still on screen. Seconds. Lines mirror the on-screen wording.",
 "lines": [
  {
   "id": "v01",
   "start": 0.45,
   "end": 2.65,
   "text": "زميلُك مصابٌ بالسكري…"
  },
  {
   "id": "v02",
   "start": 2.75,
   "end": 5.2,
   "text": "وفجأة… تغيّر حالُه."
  },
  {
   "id": "v03",
   "start": 5.4,
   "end": 7.35,
   "text": "هل تعرف ما الذي يحدث؟"
  },
  {
   "id": "v04",
   "start": 7.45,
   "end": 8.45,
   "text": "هبوطُ السكر!"
  },
  {
   "id": "v05",
   "start": 8.4,
   "end": 12.27,
   "text": "رجفةٌ وتعرّقٌ ودوخة، جوعٌ وتسارعُ نبضٍ وتشوّش."
  },
  {
   "id": "v06",
   "start": 12.3,
   "end": 14.27,
   "text": "إذا كان واعياً ويستطيع البلع:"
  },
  {
   "id": "v07",
   "start": 14.3,
   "end": 18.45,
   "text": "أعطِه خمسةَ عشرَ غراماً من سكرٍ سريع، كنصفِ كوبِ عصير."
  },
  {
   "id": "v08",
   "start": 18.47,
   "end": 23.45,
   "text": "انتظر خمسَ عشرةَ دقيقة وأعِد القياس، وكرّر إن بقي منخفضاً."
  },
  {
   "id": "v09",
   "start": 23.7,
   "end": 28.1,
   "text": "بعد تحسّنه: وجبةٌ خفيفة، فيها نشويات وبروتين."
  },
  {
   "id": "v10",
   "start": 28.4,
   "end": 30.75,
   "text": "إذا فقد الوعي، أو لم يستطع البلع…"
  },
  {
   "id": "v11",
   "start": 30.8,
   "end": 32.25,
   "text": "لا تُعطِه شيئاً بالفم…"
  },
  {
   "id": "v12",
   "start": 32.3,
   "end": 35.25,
   "text": "واتصل بالإسعاف، تسعة تسعة سبعة."
  },
  {
   "id": "v13",
   "start": 35.35,
   "end": 37.55,
   "text": "كن مستعداً، فقد تُنقذُ حياة."
  },
  {
   "id": "v14",
   "start": 37.6,
   "end": 39.9,
   "text": "المعلوماتُ كاملةٌ في الإنفوجرافيك."
  }
 ]
}