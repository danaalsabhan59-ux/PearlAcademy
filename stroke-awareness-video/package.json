{
  "name": "stroke-awareness-video",
  "version": "1.0.0",
  "description": "فيديو توعوي عن السكتة الدماغية بأسلوب Pixel Art — Remotion + Edge TTS",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "preview": "remotion studio",
    "voices": "python3 scripts/generate_voices.py",
    "voices:force": "python3 scripts/generate_voices.py --force",
    "voices:audition": "python3 scripts/audition_voices.py",
    "sfx": "python3 scripts/generate_sfx.py",
    "check:audio": "python3 scripts/check_audio.py",
    "render": "npm run check:audio && remotion render StrokeAwareness out/stroke-awareness.mp4 --codec=h264 --audio-codec=aac --audio-bitrate=320k --crf=16",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "sc:audio": "python3 scripts/generate_strokecode_audio.py",
    "sc:preview": "remotion studio",
    "sc:render": "remotion render StrokeCode out/stroke-code-world-stroke-day.mp4 --codec=h264 --image-format=png --crf=12 --x264-preset=slow --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k",
    "sc:render:muted": "remotion render StrokeCode out/stroke-code-world-stroke-day-muted.mp4 --codec=h264 --image-format=png --crf=12 --x264-preset=slow --pixel-format=yuv420p --muted",
    "sc:qc": "node scripts/qc_strokecode.mjs",
    "sc:music": "python3 scripts/generate_strokecode_tension.py",
    "sc:music:electronic": "python3 scripts/generate_strokecode_music.py",
    "sc:music:chiptune": "python3 scripts/generate_strokecode_chiptune.py"
  },
  "allowScripts": {
    "esbuild": false
  }
}
